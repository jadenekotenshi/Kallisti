# Per-primitive cost of the TLS data path (record ciphers, hashes, HMAC, X25519), for comparing before and
# after a change on the same machine.
build/bench_bulk: tools/bench_bulk.c $(CORE_OBJS)
	-mkdir build
	$(CC) $(CFLAGS) -o build/bench_bulk tools/bench_bulk.c $(CORE_OBJS)

bench-bulk: build/bench_bulk
	build/bench_bulk

# ---- install ----
# OPENSTEP's own conventions: /LocalApps for a locally-built application (parallel to /NextApps
# for vendor-shipped ones). Needs write access (root, typically); if mkdir/cp fails for that
# reason, su or sudo and try again -- this target does not do that itself.
APPDIR = /LocalApps

install: all
	-mkdir $(APPDIR)
	rm -rf $(APPDIR)/$(APP)
	cp -r $(APP) $(APPDIR)/
	@echo "installed: $(APPDIR)/$(APP)"

install-fat: fat-build
	-mkdir $(APPDIR)
	rm -rf $(APPDIR)/$(APP)
	cp -r $(APP) $(APPDIR)/
	@echo "installed fat (i386+m68k+sparc) binary: $(APPDIR)/$(APP)"

# ---- Installer package (.pkg) ----
# Built with the real packaging tool, not a hand-rolled imitation of its output -- see StepSSH's
# own Makefile.openstep for the full story of how that mechanism was worked out (real HOWTO +
# real reference package + real hardware, several rounds), and StepTTY's for the same mechanism
# confirmed working a second time. Applying those lessons directly here rather than re-deriving
# them: NEXTSTEP/OPENSTEP's Installer.app ships a csh script, /NextAdmin/Installer.app/package,
# that takes a "fake root" tree (the payload, laid out under DefaultLocation as if it were /) and a
# plain-text ".info" file (single "Keyword value" lines, NOT a "{ Key = value; }" property list)
# and does everything else itself: the compressed archive, the .bom, the .sizes file, and the
# finished .pkg. DefaultLocation /LocalApps with Kallisti.app as the only payload -- one .pkg is
# enough, there are no separate command-line tools the way StepSSH has. LongFileNames NO
# (Kallisti.app's own path is nowhere near the 100-character ustar limit, and YES was the actual
# root cause of a hard-to-diagnose StepSSH install failure -- it silently selects a buggy bundled
# tar variant for small archives). chgrp nogroup and chmod 444 on .sizes match a known-good
# reference package's own structure exactly.
PKG     = Kallisti.pkg
PKGROOT = pkgroot
PKGINFO = Kallisti.info

pkg-assemble:
	rm -rf $(PKG) $(PKGROOT) $(PKGINFO)
	mkdir $(PKGROOT)
	chgrp nogroup $(PKGROOT)
	cp -r $(APP) $(PKGROOT)/
	echo "Title Kallisti" > $(PKGINFO)
	echo "Version $(VERSION)" >> $(PKGINFO)
	echo "Description A native Discord client for OPENSTEP." >> $(PKGINFO)
	echo "DefaultLocation /LocalApps" >> $(PKGINFO)
	echo "DiskName Kallisti" >> $(PKGINFO)
	echo "Relocatable YES" >> $(PKGINFO)
	echo "Application YES" >> $(PKGINFO)
	echo "UseUserMask YES" >> $(PKGINFO)
	echo "LongFileNames NO" >> $(PKGINFO)
	/NextAdmin/Installer.app/package $(PKGROOT)/ $(PKGINFO)
	-chmod 444 $(PKG)/Kallisti.sizes
	rm -rf $(PKGROOT) $(PKGINFO)
	@echo "built $(PKG) via the real Installer.app/package tool"

pkg: all pkg-assemble

pkg-fat: fat-build
	$(MAKE) -f Makefile.openstep pkg-assemble

# ---- distributable archive of the .pkg ----
# Gzipped into Kallisti-<VERSION>-<letter(s)>.tar.gz for handing out. The letter convention
# (N=m68k, I=i386, S=sparc) matches StepSSH/StepTTY's own -- NIS for `dist-fat` (always, since
# that's exactly what `fat`/`pkg-fat` build), or whichever single letter matches the machine `dist`
# (thin) actually ran on, found with arch(1).
dist: pkg
	case "`arch`" in \
	    m68k) suf=N ;; \
	    i386) suf=I ;; \
	    sparc) suf=S ;; \
	    *) suf="`arch`" ;; \
	esac; \
	tar -cvf - $(PKG) | gzip -9c > Kallisti-$(VERSION)-$$suf.tar.gz; \
	echo "built Kallisti-$(VERSION)-$$suf.tar.gz"

dist-fat: pkg-fat
	tar -cvf - $(PKG) | gzip -9c > Kallisti-$(VERSION)-NIS.tar.gz
	@echo "built Kallisti-$(VERSION)-NIS.tar.gz"

# ---- optional multi-architecture ("fat") build ----
# NeXT's cc accepts several -arch flags in one invocation: each source is compiled once per
# architecture and the per-arch object code is combined into one fat Mach-O file automatically,
# and linking with the same set of -arch flags produces a fat executable. This only works if the
# target architecture's compiler backend is actually installed as part of your Developer Tools;
# the m68k/sparc components were separate from a plain Intel install on some OPENSTEP CD sets.
#
#   make -f Makefile.openstep fat-check    # fast: does cc even accept these -arch flags here?
#   make -f Makefile.openstep fat          # full: Kallisti.app as an i386+m68k+sparc fat binary
#
# Built as three separate passes, not one multi-`-arch` cc invocation: -m486, M68KOPT and SPARCOPT (see the
# .c.o:/.m.o: rules above) each measurably help on their own architecture but are single-architecture gcc
# switch sets the other backends reject, and NeXT's cc has no per-arch flag scoping (no -Xarch_i386 the way
# Apple's later toolchain gained). So `fat-build` compiles each architecture on its own with its own tuning
# and `lipo -create`s the three finished binaries together (StepSSH's fat build works the same way, and was
# confirmed on real hardware there). Each group must be a real -arch list (an empty one would turn its pass
# into a native thin build), so to build fewer architectures edit fat-build itself.
FATARCHS_X86   = -arch i386
FATARCHS_M68K  = -arch m68k
FATARCHS_SPARC = -arch sparc
FATARCHS       = $(FATARCHS_X86) $(FATARCHS_M68K) $(FATARCHS_SPARC)
FATSTAGE       = fatstage

fat-check:
	@echo "int main(void) { return 0; }" > /tmp/kallisti_fatcheck.c
	$(CC) $(FATARCHS) -c /tmp/kallisti_fatcheck.c -o /tmp/kallisti_fatcheck.o
	@echo "compiled for all requested architectures; slices actually present:"
	lipo -info /tmp/kallisti_fatcheck.o
	@rm -f /tmp/kallisti_fatcheck.c /tmp/kallisti_fatcheck.o

# Shared three-pass build behind fat/install-fat/pkg-fat: builds the app once per architecture (x86 with -m486
# folded into OPT, m68k with OPT replaced by M68KOPT, sparc with OPT replaced by SPARCOPT), staging the first
# two passes' executables aside in $(FATSTAGE) (cleaning between each), then lipo-merges them with the sparc one.
fat-build:
	rm -rf $(FATSTAGE)
	mkdir $(FATSTAGE)
	$(MAKE) -f Makefile.openstep clean
	$(MAKE) -f Makefile.openstep all ARCHS="$(FATARCHS_X86)" OPT="$(OPT) -m486"
	cp $(APP)/Kallisti $(FATSTAGE)/Kallisti-x86
	$(MAKE) -f Makefile.openstep clean
	$(MAKE) -f Makefile.openstep all ARCHS="$(FATARCHS_M68K)" OPT="$(M68KOPT)"
	cp $(APP)/Kallisti $(FATSTAGE)/Kallisti-m68k
	$(MAKE) -f Makefile.openstep clean
	$(MAKE) -f Makefile.openstep all ARCHS="$(FATARCHS_SPARC)" OPT="$(SPARCOPT)"
	lipo -create $(FATSTAGE)/Kallisti-x86 $(FATSTAGE)/Kallisti-m68k $(APP)/Kallisti -output $(APP)/Kallisti
	rm -rf $(FATSTAGE)

fat: fat-build
	@echo "== fat build done (i386 pass used -m486, m68k pass used M68KOPT, sparc pass used SPARCOPT); architectures actually present in $(APP)/Kallisti: =="
	lipo -info $(APP)/Kallisti

clean:
	rm -f core/*.o app/*.o tests/*.o
	rm -rf build $(APP) $(PKG) $(PKGROOT) $(PKGINFO)
	rm -f Kallisti-*.tar.gz
