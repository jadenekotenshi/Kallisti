# Build Kallisti on OPENSTEP 4.2 (gcc 2.7.2).  Works with NeXT make or GNU make.
#
#   make -f Makefile.openstep test     # FIRST: run the C unit tests on the real compiler
#   make -f Makefile.openstep          # build Kallisti.app
#   make -f Makefile.openstep install  # into /LocalApps (see below)
#   make -f Makefile.openstep pkg      # Kallisti.pkg for Installer.app (see below)
#   make -f Makefile.openstep dist     # Kallisti.pkg, gzipped as Kallisti-<VERSION>-<letter>.tar.gz
#   make -f Makefile.openstep fat          # Kallisti.app as an i386+m68k+sparc fat binary (see below)
#   make -f Makefile.openstep install-fat  # fat app into /LocalApps
#   make -f Makefile.openstep pkg-fat      # Kallisti.pkg with the fat build
#   make -f Makefile.openstep dist-fat     # fat Kallisti.pkg, gzipped as Kallisti-<VERSION>-NIS.tar.gz
#   make -f Makefile.openstep clean
#
# No GNU-make features are used (no wildcard, no pattern rules) so the stock NeXT make can read it.  Object
# files are written next to their sources.  The tests read tests/certs/ and write build/, so run `test` from
# this directory.
#
# Nothing in this file has been run on real OPENSTEP hardware yet -- Kallisti is brand new.  Everything here is
# carried over from RatChat's Makefile.openstep (itself from StepSSH's and StepTTY's, whose per-architecture
# tuning, __ICON segment, packaging and fat-build mechanics were each confirmed on real hardware); report back
# exactly what happens on the first real build/run.  The unit tests of the vendored crypto/TLS core are the
# same ones RatChat passes; core/chain.c, core/rest.c, core/model.c and the rest are new and have only run on
# the development host so far.

CC       = cc
OPT      = -O
DEFS     = -DOPENSTEP
ARCHS    =                        # e.g. -arch i386 -arch m68k -arch sparc; see `fat` below
CFLAGS   = $(OPT) -Wall $(DEFS) $(ARCHS) -Iapp -Icore
# Per-architecture tuning, ported from StepSSH (where each was benched on real hardware): a 68040 does
# better at -O2 -fomit-frame-pointer -m68040 than plain $(OPT); SPARC needs -mv8 (OPENSTEP only ever ran
# on the sun4m SPARCstations, every one of them V8) to get the hardware integer multiply instead of gcc
# 2.7.2's default V7 code's library calls, and does better at -O2; and core/chacha.c alone does better at
# plain -O there (ChaCha20 76.7 -> about 99 MB/s, a whole 32 KB chacha20-poly1305 seal 745 -> 426 us --
# Poly1305 lives in the same file). x86 gets -m486, added by the .c.o rule below. Each set replaces $(OPT).
M68KOPT        = -O2 -fomit-frame-pointer -m68040
M68KCFLAGS     = $(M68KOPT) -Wall $(DEFS) $(ARCHS) -Iapp -Icore
SPARCOPT       = -O2 -mv8
SPARCCHACHAOPT = -O -mv8
LIBS     = -framework AppKit -framework Foundation
APP      = Kallisti.app
VERSION  = 0.1.1

# Workspace takes an application's icon (and its file-type table) from a read-only __ICON segment
# linked into the executable, not from a file in the .app folder -- and, on real hardware, Workspace
# Manager silently refuses to launch a bundle lacking one at all (confirmed twice already, in both
# StepSSH and StepTTY, before either got its own icon -- applied here from the start instead of
# waiting to hit the same failure a third time). app/Kallisti.iconheader says which icon belongs to
# the app; app/Kallisti.tiff is the icon (regenerate: python3 tools/gen_icon.py).
ICONHDR   = app/Kallisti.iconheader
ICONTIFF  = app/Kallisti.tiff
ICONFLAGS = -sectcreate __ICON __header $(ICONHDR) -segprot __ICON r r -sectcreate __ICON app $(ICONTIFF)

CORE_OBJS = core/aes.o core/base64.o core/bignum.o core/chacha.o core/chain.o core/client.o \
            core/der.o core/ecc.o core/emoji.o core/gateway.o core/gif.o core/hmac.o core/http.o \
            core/img.o core/inflate.o core/jpeg.o core/json.o core/kprefs.o core/ktime.o core/md5.o \
            core/model.o core/nacl.o core/netconn.o core/png.o core/rest.o core/rng.o core/roots.o \
            core/roots_bundled.o core/rsa.o core/sha1.o core/sha2.o core/tls.o \
            core/tls_aead_chacha.o core/tls_aead_gcm.o core/tls_pins.o core/tls_prf.o \
            core/tls_wire.o core/wire.o core/ws.o core/x509.o
APP_OBJS  = app/AppController.o app/ChannelPane.o app/ChannelWindow.o app/DMController.o \
            app/ImageListController.o app/ImageWindow.o app/LoginController.o app/MainController.o \
            app/ReactController.o app/SecretField.o app/UIHelpers.o app/main.o

.SUFFIXES: .c .m .o

# -m486, M68KOPT and SPARCOPT are single-architecture gcc switch sets the other backends reject, so each
# is only added for a genuine thin build of its own architecture: no -arch override in play (empty
# ARCHS) and `arch(1)` reporting that exact architecture. A `fat` build shares one CFLAGS across every
# `-arch` in a single cc invocation and NeXT's cc has no per-arch flag scoping, so `fat-build` below
# compiles each architecture as its own pass instead. The SPARC branch matches both a thin build
# ("-sparc") and the fat build's sparc pass ("-arch sparc-<the building machine>") and picks core/chacha.c's
# own SPARCCHACHAOPT.
.c.o:
	@case "$(ARCHS)-`arch`" in \
	    -i386) echo $(CC) $(CFLAGS) -m486 -c $< -o $@; $(CC) $(CFLAGS) -m486 -c $< -o $@ ;; \
	    -m68k) echo $(CC) $(M68KCFLAGS) -c $< -o $@; $(CC) $(M68KCFLAGS) -c $< -o $@ ;; \
	    -sparc|"-arch sparc-"*) o="$(SPARCOPT)"; [ "$<" = core/chacha.c ] && o="$(SPARCCHACHAOPT)"; \
	        echo $(CC) $$o -Wall $(DEFS) $(ARCHS) -Iapp -Icore -c $< -o $@; \
	        $(CC) $$o -Wall $(DEFS) $(ARCHS) -Iapp -Icore -c $< -o $@ ;; \
	    *) echo $(CC) $(CFLAGS) -c $< -o $@; $(CC) $(CFLAGS) -c $< -o $@ ;; \
	esac

.m.o:
	@case "$(ARCHS)-`arch`" in \
	    -i386) echo $(CC) $(CFLAGS) -m486 -c $< -o $@; $(CC) $(CFLAGS) -m486 -c $< -o $@ ;; \
	    -m68k) echo $(CC) $(M68KCFLAGS) -c $< -o $@; $(CC) $(M68KCFLAGS) -c $< -o $@ ;; \
	    -sparc|"-arch sparc-"*) o="$(SPARCOPT)"; \
	        echo $(CC) $$o -Wall $(DEFS) $(ARCHS) -Iapp -Icore -c $< -o $@; \
	        $(CC) $$o -Wall $(DEFS) $(ARCHS) -Iapp -Icore -c $< -o $@ ;; \
	    *) echo $(CC) $(CFLAGS) -c $< -o $@; $(CC) $(CFLAGS) -c $< -o $@ ;; \
	esac

all: $(APP)/Kallisti

$(APP)/Kallisti: $(CORE_OBJS) $(APP_OBJS) $(ICONHDR) $(ICONTIFF) app/emoji.pack EMOJI-LICENSE.txt
	-mkdir $(APP)
	@( cd $(APP) ) >/dev/null 2>&1 || { echo "make: $(APP) is missing or is not a directory:"; ls -ld $(APP); echo "remove it and run make again"; exit 1; }
	$(CC) $(ARCHS) -o $(APP)/Kallisti $(CORE_OBJS) $(APP_OBJS) $(ICONFLAGS) $(LIBS) || { echo "make: linking with the __ICON segment failed; retrying without an icon"; $(CC) $(ARCHS) -o $(APP)/Kallisti $(CORE_OBJS) $(APP_OBJS) $(LIBS); }
	cp app/emoji.pack $(APP)/emoji.pack
	cp EMOJI-LICENSE.txt $(APP)/EMOJI-LICENSE.txt

# Show what was linked in: expect a segment __ICON with sections __header and app.
iconcheck:
	otool -l $(APP)/Kallisti | grep -A 3 __ICON

# ---- unit tests (plain C, no AppKit) ----
